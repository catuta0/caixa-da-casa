# Copia este ficheiro para .env e preenche.

# Endereço onde a app vai ficar, sem https:// (tem de apontar para o teu servidor)
DOMINIO=caixa.exemplo.pt

# ID de cliente OAuth do Google (termina em .apps.googleusercontent.com). Ver README.
GOOGLE_CLIENT_ID=

# Opcional: o teu email Google, para ficares logo tesoureiro sem aprovação. Vários? Separa por vírgulas.
# Se ficar vazio, quem entrar primeiro como tesoureiro fica aprovado.
TESOUREIRO_EMAIL=

# Nome que aparece no ecrã de entrada (depois muda-se em Definições)
NOME_CASA=Casa comunitária
